{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://researchos.local/contracts/v1/version_diff.schema.json",
  "title": "VersionDiff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "diff_id",
    "from_version_id",
    "to_version_id",
    "changed_objects",
    "changed_relations",
    "affected_model_runs",
    "affected_claims",
    "reused_refs",
    "summary"
  ],
  "properties": {
    "contract_version": {
      "const": "0.1.0-frozen"
    },
    "diff_id": {
      "type": "string"
    },
    "from_version_id": {
      "type": "string"
    },
    "to_version_id": {
      "type": "string"
    },
    "changed_objects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "changed_relations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affected_model_runs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reused_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}
