{
  "registry_type": "data_sources",
  "registry_version": "0.1.0",
  "items": [
    {
      "source_id": "FRED_ALFRED",
      "name": "Federal Reserve Economic Data / ALFRED",
      "official_docs": "https://fred.stlouisfed.org/docs/api/fred/overview.html",
      "access": "free_api_key",
      "secret_env": "FRED_API_KEY",
      "formats": ["json", "xml"],
      "domains": ["activity", "labor", "inflation", "rates", "financial_conditions", "housing", "commodities"],
      "vintage_mode": "upstream_true_vintage",
      "refresh_policy": "release_driven_and_daily",
      "mvp_priority": "P0",
      "notes": "Use ALFRED realtime/vintage fields for point-in-time backtests; do not assume every FRED series has equally complete revision history.",
      "status": "draft"
    },
    {
      "source_id": "BLS_PUBLIC_DATA",
      "name": "U.S. Bureau of Labor Statistics Public Data API",
      "official_docs": "https://www.bls.gov/developers/",
      "access": "free_key_optional_for_v1_required_for_registered_v2",
      "secret_env": "BLS_API_KEY",
      "formats": ["json"],
      "domains": ["cpi", "ppi", "employment", "unemployment", "wages", "eci", "jolts", "productivity"],
      "vintage_mode": "local_release_snapshots",
      "refresh_policy": "official_release_calendar",
      "mvp_priority": "P0",
      "notes": "Store series metadata and catalog separately; quotas belong in runtime policy rather than hard-coded business logic.",
      "status": "draft"
    },
    {
      "source_id": "BEA_API",
      "name": "U.S. Bureau of Economic Analysis API",
      "official_docs": "https://apps.bea.gov/api/signup/",
      "access": "free_api_key",
      "secret_env": "BEA_API_KEY",
      "formats": ["json", "xml"],
      "domains": ["nipa", "industry_gdp", "pce", "income", "saving", "ita", "iip", "fixed_assets", "input_output", "regional"],
      "vintage_mode": "local_release_snapshots",
      "refresh_policy": "official_release_calendar",
      "mvp_priority": "P0",
      "notes": "Preserve TableName, LineNumber, GeoFIPS and result metadata so factors are not tied to display labels.",
      "status": "draft"
    },
    {
      "source_id": "CENSUS_DATA_API",
      "name": "U.S. Census Bureau Data APIs",
      "official_docs": "https://www.census.gov/data/developers/data-sets.html",
      "access": "free_api_key",
      "secret_env": "CENSUS_API_KEY",
      "formats": ["json"],
      "domains": ["international_trade", "retail", "wholesale", "manufacturing", "housing", "construction", "business_surveys"],
      "vintage_mode": "local_release_snapshots",
      "refresh_policy": "official_release_calendar",
      "mvp_priority": "P0",
      "notes": "International trade documentation: https://www.census.gov/data/developers/data-sets/international-trade.html. Lock geography, product classification and seasonal-adjustment semantics per factor.",
      "status": "draft"
    },
    {
      "source_id": "EIA_API_V2",
      "name": "U.S. Energy Information Administration Open Data API v2",
      "official_docs": "https://www.eia.gov/opendata/",
      "access": "free_api_key",
      "secret_env": "EIA_API_KEY",
      "formats": ["json", "csv"],
      "domains": ["petroleum", "natural_gas", "electricity", "coal", "total_energy", "steo", "aeo"],
      "vintage_mode": "local_release_snapshots",
      "refresh_policy": "daily_weekly_monthly_by_route",
      "mvp_priority": "P0",
      "notes": "Forecast tables such as STEO require snapshot versioning; do not overwrite old forecast paths.",
      "status": "draft"
    },
    {
      "source_id": "TREASURY_FISCAL_DATA",
      "name": "U.S. Treasury Fiscal Data API",
      "official_docs": "https://fiscaldata.treasury.gov/api-documentation/",
      "access": "public_no_key",
      "secret_env": null,
      "formats": ["json", "csv", "xml"],
      "domains": ["debt", "interest_expense", "receipts", "outlays", "deficit", "auctions", "debt_structure"],
      "vintage_mode": "local_daily_snapshots",
      "refresh_policy": "daily_and_release_driven",
      "mvp_priority": "P0",
      "notes": "Dataset routes and field names must be versioned in the registry; period_end and record_date have different semantics.",
      "status": "draft"
    },
    {
      "source_id": "FED_DDP",
      "name": "Federal Reserve Data Download Program",
      "official_docs": "https://www.federalreserve.gov/datadownload/",
      "access": "public_no_key",
      "secret_env": null,
      "formats": ["csv", "xml", "sdmx"],
      "domains": ["h15_rates", "g17_industrial", "h8_banking", "z1_financial_accounts", "dsr", "h10_fx", "h6_money", "g19_credit"],
      "vintage_mode": "current_values_plus_local_snapshots",
      "refresh_policy": "release_driven",
      "mvp_priority": "P0",
      "notes": "Prefer ALFRED when a reliable vintage exists; use DDP for richer official release tables and cross-checking.",
      "status": "draft"
    },
    {
      "source_id": "NYFED_MARKETS",
      "name": "Federal Reserve Bank of New York Markets API",
      "official_docs": "https://markets.newyorkfed.org/static/docs/markets-api.html",
      "access": "public_no_key",
      "secret_env": null,
      "formats": ["json", "xml", "csv"],
      "domains": ["sofr", "effr", "obfr", "tgcr", "bgcr", "reference_rate_volumes"],
      "vintage_mode": "local_daily_snapshots",
      "refresh_policy": "business_daily",
      "mvp_priority": "P0",
      "notes": "Use publication dates and revisions from the official endpoint; business-day calendars are explicit dependencies.",
      "status": "draft"
    },
    {
      "source_id": "USA_SPENDING",
      "name": "USAspending API",
      "official_docs": "https://api.usaspending.gov/",
      "access": "public_no_key",
      "secret_env": null,
      "formats": ["json"],
      "domains": ["federal_contracts", "grants", "subsidies", "geographic_spending", "industry_spending"],
      "vintage_mode": "local_snapshots",
      "refresh_policy": "weekly",
      "mvp_priority": "P1",
      "notes": "Awards data are not identical to NIPA fiscal impulse; preserve obligation/outlay/action date semantics.",
      "status": "draft"
    },
    {
      "source_id": "TREASURY_TIC_FILES",
      "name": "Treasury International Capital System",
      "official_docs": "https://home.treasury.gov/data/treasury-international-capital-tic-system",
      "access": "public_files",
      "secret_env": null,
      "formats": ["csv", "xlsx", "html"],
      "domains": ["cross_border_securities", "bank_flows", "foreign_treasury_holdings"],
      "vintage_mode": "local_release_snapshots",
      "refresh_policy": "official_release_calendar",
      "mvp_priority": "P1",
      "notes": "Implement as a file/table adapter; do not assume a stable REST endpoint where none is documented.",
      "status": "draft"
    },
    {
      "source_id": "NOAA_CDO",
      "name": "NOAA Climate Data Online Web Services",
      "official_docs": "https://www.ncei.noaa.gov/cdo-web/webservices/v2",
      "access": "free_token",
      "secret_env": "NOAA_CDO_TOKEN",
      "formats": ["json"],
      "domains": ["temperature", "precipitation", "extreme_weather"],
      "vintage_mode": "local_snapshots",
      "refresh_policy": "daily_or_monthly_by_dataset",
      "mvp_priority": "P2",
      "notes": "Spatial aggregation and station coverage are research definitions, not LLM-selected free text.",
      "status": "draft"
    },
    {
      "source_id": "USDA_NASS_QUICKSTATS",
      "name": "USDA NASS Quick Stats API",
      "official_docs": "https://quickstats.nass.usda.gov/api",
      "access": "free_api_key",
      "secret_env": "USDA_NASS_API_KEY",
      "formats": ["json"],
      "domains": ["crop_area", "crop_yield", "production", "agricultural_prices"],
      "vintage_mode": "local_release_snapshots",
      "refresh_policy": "release_driven",
      "mvp_priority": "P2",
      "notes": "Commodity, statistic category, unit, aggregation level and geography require registered query templates.",
      "status": "draft"
    },
    {
      "source_id": "OPEN_FEMA",
      "name": "OpenFEMA API",
      "official_docs": "https://www.fema.gov/about/openfema/api",
      "access": "public_no_key",
      "secret_env": null,
      "formats": ["json", "csv"],
      "domains": ["disaster_declarations", "assistance", "hazard_programs"],
      "vintage_mode": "local_snapshots",
      "refresh_policy": "weekly",
      "mvp_priority": "P2",
      "notes": "Disaster declaration and assistance are not direct physical-loss measures; lineage must preserve that distinction.",
      "status": "draft"
    },
    {
      "source_id": "SEC_EDGAR",
      "name": "SEC EDGAR APIs",
      "official_docs": "https://www.sec.gov/search-filings/edgar-application-programming-interfaces",
      "access": "public_no_key_user_agent_required",
      "secret_env": "SEC_USER_AGENT",
      "formats": ["json", "xbrl", "html"],
      "domains": ["company_facts", "submissions", "filings", "capex", "debt"],
      "vintage_mode": "filing_time_snapshots",
      "refresh_policy": "daily",
      "mvp_priority": "P2",
      "notes": "Respect SEC fair-access policy. AI-related capex classification needs a separately audited extraction layer.",
      "status": "draft"
    }
  ]
}
