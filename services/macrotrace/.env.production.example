# Copy this file to .env.production on the server. Never commit the real file.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
CENSUS_API_KEY=
EIA_API_KEY=

MACROTRACE_ENV=production
MACROTRACE_SERVE_FRONTEND=true
MACROTRACE_DATABASE_PATH=/app/runtime/macrotrace.duckdb
MACROTRACE_ARTIFACT_DIR=/app/runtime/artifacts
MACROTRACE_ALLOWED_HOSTS=YOUR_DOMAIN,localhost,127.0.0.1
MACROTRACE_CORS_ORIGINS=https://YOUR_DOMAIN
MACROTRACE_TRUST_PROXY_HEADERS=true
MACROTRACE_ALLOW_DATA_SYNC=false
MACROTRACE_SYNC_ADMIN_KEY=
MACROTRACE_JOB_RATE_LIMIT_PER_MINUTE=3
MACROTRACE_MAX_QUEUED_JOBS=3
MACROTRACE_MAX_JOB_WORKERS=1
