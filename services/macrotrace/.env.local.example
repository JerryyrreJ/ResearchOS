# Copy to .env.local through scripts/configure_api_keys.ps1.
# Never commit the real file.
FRED_API_KEY=
BLS_API_KEY=
BEA_API_KEY=
CENSUS_API_KEY=
EIA_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Release runtime. Keep local defaults unless running the backend separately.
MACROTRACE_ENV=local
MACROTRACE_SERVE_FRONTEND=true
MACROTRACE_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000
MACROTRACE_DATABASE_PATH=data/macrotrace.duckdb
MACROTRACE_ARTIFACT_DIR=artifacts/jobs
MACROTRACE_SNAPSHOT_URI=
MACROTRACE_SNAPSHOT_SHA256=
MACROTRACE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
MACROTRACE_TRUST_PROXY_HEADERS=false
MACROTRACE_ALLOW_DATA_SYNC=true
MACROTRACE_SYNC_ADMIN_KEY=
MACROTRACE_JOB_RATE_LIMIT_PER_MINUTE=3
MACROTRACE_MAX_QUEUED_JOBS=3
MACROTRACE_MAX_JOB_WORKERS=1
