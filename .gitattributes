# Evidence artifact hashes are defined over the exact LF-normalized bytes.
# Keep Windows checkouts deterministic without changing the frozen Git blobs.
fixtures/evidence/artifacts/*.json text eol=lf
apps/web/**/*.ts text eol=lf
apps/web/**/*.tsx text eol=lf
apps/web/**/*.mjs text eol=lf
apps/web/**/*.css text eol=lf
apps/web/**/*.json text eol=lf
apps/web/**/*.md text eol=lf
