{
  "$defs": {
    "BlockingIssue": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "minLength": 3,
          "title": "Issue Id",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "severity": {
          "enum": [
            "WARNING",
            "BLOCKING"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "severity",
        "message"
      ],
      "title": "BlockingIssue",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "RESEARCH_QUESTION",
        "CLAIM",
        "MECHANISM",
        "VARIABLE_DEFINITION",
        "DATA_SOURCE",
        "MODEL_SPECIFICATION",
        "IDENTIFICATION",
        "DIAGNOSTIC",
        "ROBUSTNESS",
        "RESULT",
        "LIMITATION",
        "AGGREGATION"
      ],
