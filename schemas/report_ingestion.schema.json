        "identification_strategy": {
          "default": "",
          "title": "Identification Strategy",
          "type": "string"
        },
        "identifying_assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Identifying Assumptions",
          "type": "array"
        },
        "independent_variable_ids": {
          "items": {
            "type": "string"
          },
          "title": "Independent Variable Ids",
          "type": "array"
        },
        "lane_ref": {
          "default": "",
          "title": "Lane Ref",
          "type": "string"
        },
        "mechanism_ref": {
          "default": "",
          "title": "Mechanism Ref",
          "type": "string"
        },
        "method_family": {
          "default": "",
          "title": "Method Family",
          "type": "string"
        },
        "method_route_id": {
          "minLength": 5,
          "title": "Method Route Id",
          "type": "string"
        },
        "node_ref": {
          "default": "",
          "title": "Node Ref",
          "type": "string"
        },
        "research_question_id": {
          "minLength": 5,
          "title": "Research Question Id",
          "type": "string"
        },
        "robustness_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Robustness Requirements",
          "type": "array"
        },
        "sample_definition": {
          "default": "",
          "title": "Sample Definition",
          "type": "string"
        },
        "upstream_refs": {
          "items": {
            "type": "string"
          },
          "title": "Upstream Refs",
          "type": "array"
        }
      },
      "required": [
        "method_route_id",
        "research_question_id"
