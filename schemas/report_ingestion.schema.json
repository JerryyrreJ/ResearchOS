        "role": {
          "enum": [
            "DEPENDENT",
            "OUTCOME",
            "EXPOSURE",
            "TREATMENT",
            "INSTRUMENT",
            "CONTROL",
            "STATE",
            "WEIGHT",
            "OTHER"
          ],
          "title": "Role",
          "type": "string"
        },
        "table_or_series": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Or Series"
        },
        "transformation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transformation"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "variable_id": {
          "minLength": 3,
          "title": "Variable Id",
          "type": "string"
        },
        "vintage_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vintage Rule"
        }
      },
      "required": [
        "variable_id",
        "role"
      ],
      "title": "VariableDefinition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "minLength": 3,
      "title": "Batch Id",
      "type": "string"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/BlockingIssue"
      },
      "title": "Blockers",
      "type": "array"
    },
