# ResearchOS Python backend
RESEARCHOS_DATABASE_URL=sqlite:///./var/researchos.db
RESEARCHOS_BLOB_ROOT=./var/blobs
RESEARCHOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional FRED provider. Keep the real key only in .env.local.
FRED_API_KEY=

# Optional browser override when the API does not run on localhost:8000.
NEXT_PUBLIC_RESEARCHOS_API_BASE_URL=http://127.0.0.1:8000/api/v1
# Role B's original MacroTrace workbench. The D shell embeds this endpoint.
NEXT_PUBLIC_MACROTRACE_UI_URL=http://127.0.0.1:8000
